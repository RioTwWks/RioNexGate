# ----------------------
#  Docker / Контейнеры
# ----------------------
# Docker Compose переопределения (исключаем все override файлы)
docker-compose.override.yml
docker-compose.*.yml

# Образы и кэши Docker (обычно не в репозитории)
*.tar
*.tar.gz
docker-build.log

# ----------------------
#  Данные приложения и временные файлы
# ----------------------
/data/               # SQLite, конфиги ядер, логи, сертификаты (все данные)
/data/*
!/data/.gitkeep

# Логи приложения
*.log
logs/
*.pid

# Секреты и конфиги с паролями
.env
.env.local
.env.*.local
# API-ключи и токены Telegram — только локально (шаблон: config.example.yaml)
backend/config.yaml
backend/config.yml
*.secret
*.key
*.pem
*.crt
!examples/*.pem       # примеры сертификатов можно сохранить

# ----------------------
#  Системные файлы
# ----------------------
Thumbs.db
ehthumbs.db
Desktop.ini
*.bak
*.tmp
*.temp

# ----------------------
#  Архивы и сборки
# ----------------------
*.zip
*.tgz
*.gz
*.rar
*.7z
*.dmg

# ----------------------
#  Скрипты (если они генерируют временные данные)
# ----------------------
/scripts/*.tmp
/scripts/*.bak

# ----------------------
#  Документация и покрытие (если генерируются позже)
# ----------------------
/backend/coverage.html
/backend/coverage.out
/frontend/coverage/

# ----------------------
#  Специфичное для Cursor (если нужно)
# ----------------------
# .cursor/ обычно хранит настройки, но можно исключить временные файлы
.cursor/tmp/
.cursor/*.log
/e2e/data/
/e2e/test-results/
/e2e/playwright-report/
/e2e/blob-report/