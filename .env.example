# HTTPS (optional)
# Uncomment after running scripts/letsencrypt.sh and enabling nginx-https.conf.example
# HTTPS_PORT=8443
# DOMAIN=panel.example.com

# Pinned Xray-core version for docker compose profile cores
XRAY_VERSION=26.3.27

# Pinned SkadiCore version for docker compose profile cores
# https://github.com/RioTwWks/SkadiCore/releases
SKADI_VERSION=0.1.3

# Optional: override pinned sing-box image
# SINGBOX_IMAGE=ghcr.io/sagernet/sing-box:v1.14.2

# Optional: override pinned AmneziaWG (userspace) image
# AWG_IMAGE=amneziavpn/amneziawg-go:3.1.20260828

# Optional: encrypt backups with age (public recipient)
# AGE_RECIPIENT=age1...
# For restore: AGE_IDENTITY=/path/to/age-identity.txt
