# Telegram (опционально; можно задать в backend/config.yaml)
TELEGRAM_BOT_TOKEN=

# Порт веб-панели (nginx). 80 часто занят системным nginx/apache.
HTTP_PORT=8888

# Каталог для scripts/backup.sh
BACKUP_DIR=./backups

# Путь к конфигу внутри контейнера backend (обычно не менять)
CONFIG_PATH=/app/config.yaml
