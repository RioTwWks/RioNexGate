# Generated by RioNexGate — do not edit by hand (overwritten on Reload).
[server]
listen = [{{jsonStrings .ListenAddrs}}]

[protocol.socks5]
enabled = false

[protocol.vless]
enabled = true
{{- range .Users}}

[[protocol.vless.users]]
id = "{{.UUID}}"
email = "{{.Email}}"
{{- end}}
{{- if .UseReality}}

[transport.reality]
enabled = true
dest = "{{.Stealth.Reality.Dest}}"
server_names = [{{jsonStrings .Stealth.Reality.ServerNames}}]
private_key = "{{.Stealth.Reality.PrivateKey}}"
short_ids = [{{jsonStrings .Stealth.Reality.ShortIDs}}]
kex_mode = "classic"
{{- if .UseXHTTP}}

[transport.xhttp]
enabled = true
path = "{{.Stealth.XHTTP.Path}}"
mode = "{{.Stealth.XHTTP.Mode}}"
{{- end}}
{{- end}}
{{- if .APIAddress}}

[api]
enabled = true
listen = "{{.APIListenAddress}}"
token = "{{.APIToken}}"
rate_limit_per_sec = 30
{{- end}}
{{- if .MetricsAddress}}

[metrics]
enabled = true
listen = "{{.MetricsAddress}}"
{{- end}}
