{
  "log": {
    "level": "warn"
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-in",
      "listen": "::",
      "listen_port": {{.ListenPort}},
      "users": [
{{- range $i, $u := .Users}}{{if $i}},{{end}}
        {
          "uuid": "{{$u.UUID}}",
          "name": "{{$u.Email}}"
        }
{{- end}}
      ],
      "tls": {
        "enabled": false
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "experimental": {
    "clash_api": {
      "external_controller": "{{.APIAddress}}"
    }
  }
}
